# ClickUp Personal API Token (starts with "pk_")
# ClickUp Settings → Apps → Generate a Personal API Token
CLICKUP_API_KEY=pk_your_token_here

# ClickUp Team / Workspace ID
# Found in your workspace URL: https://app.clickup.com/{TEAM_ID}/
CLICKUP_TEAM_ID=your_team_id_here

# ClickUp Space ID used for the "Active Projects" count (optional)
# Found in a space URL: https://app.clickup.com/{TEAM_ID}/v/o/s/{SPACE_ID}
CLICKUP_SPACE_ID=90125160522

# --- ClickUp -> Supabase sync (/api/sync) ---
# Only needed if you want the ERP mirror populated. The dashboard itself
# works without these.

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key. Bypasses RLS, so this is server-only — never expose it to
# the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for triggering /api/sync manually:
#   curl -X POST -H "Authorization: Bearer $SYNC_SECRET" <url>/api/sync
# Vercel Cron requests are authorised by their own header and don't need this.
SYNC_SECRET=
